# ============================================================================
# SV Multi-Agent configuration (Go-only, agents run in-process)
#
# The sv-multi-agent service owns all configuration. The first-run `svma setup`
# wizard stores LLM settings in the user config directory; environment variables
# below override the saved file.
# ============================================================================

# --- Networking --------------------------------------------------------------
# sv-multi-agent listen address (server) and client address.
# LISTEN_ADDR=:50050
SVMA_ADDR=127.0.0.1:50050

# --- Paths -------------------------------------------------------------------
# WORKSPACE_ROOT=./workspace
# DATA_DIR=./data

# --- LLM ---------------------------------------------------------------------
# Default: opencode-go (OpenCode Go) exposes an OpenAI-compatible
# /chat/completions endpoint. Put your OpenCode API key (oc_sk_...) in
# LLM_API_KEY (in .env, which is git-ignored).
# Go/Go Plus base URL ends with /inference/go/openai/v1; pay-as-you-go Console
# uses /inference/openai/v1. Use LLM_MODE=mock for the offline counter demo.
LLM_MODE=openai-compatible
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180
# max_tokens is the OUTPUT cap, not the context window. deepseek-v4.1-flash
# allows up to 384k output; 32k is a safe default for large JSON plans.
LLM_MAX_TOKENS=32768
# SVMA_VERBOSE=1 logs full prompts, responses, workflow steps and simulator commands.

# --- RAG / pgvector (always enabled) ----------------------------------------
# Requires Postgres with the pgvector extension (docker-compose provides it).
RAG_INDEX_TASKS=1
# Local run: compose publishes pgvector on 5433 (5432 may be taken by a local
# PostgreSQL). Inside Docker, compose overrides this with `postgres:5432`.
DATABASE_URL=postgres://svma:svma@localhost:5433/svma?sslmode=disable

# Qwen3-Embedding-4B served by vLLM/Ollama/llama.cpp behind llm.home.
# The endpoint is HTTP and returns 2560-dimensional vectors.
EMBEDDING_BASE_URL=http://llm.home/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_DIM=2560
# Set to 1 only if you switch the endpoint to self-signed HTTPS.
EMBEDDING_INSECURE_SKIP_VERIFY=0
# Prefer a CA file over skipping verification when available.
# EMBEDDING_CA_FILE=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=4
# Qwen3-Embedding instruction prefix; \n is expanded by the client.
EMBEDDING_QUERY_PREFIX=Instruct: Given a SystemVerilog design request, retrieve relevant designs, contracts and fixes.\nQuery: 

RAG_TOP_K=6
RAG_MAX_CHARS=12000
RAG_MIN_SCORE=0.2

# --- MCP (optional) ----------------------------------------------------------
# Empty MCP_COMMAND disables MCP. Accepts a JSON array or a comma-separated list.
# MCP_COMMAND=["npx","-y","@modelcontextprotocol/server-filesystem","."]
MCP_COMMAND=
# MCP_INIT_PARAMS=

# --- Workflow / simulation ---------------------------------------------------
ARCHITECT_MAX_REVISIONS=2
CONTRACT_ONLY=1
# Cap source context sent to the LLM; large files are reduced to a structure map.
MAX_SOURCE_CHARS=24000
# Decompose large contracts into a module hierarchy with the Planner agent.
DECOMPOSE_ENABLED=1
DECOMPOSE_MIN_LINES=400
# Parallel sub-module Coder calls (<=1 runs them sequentially).
CODER_CONCURRENCY=4
SIM_TOP_MODULE=tb
# Simulator backend: "verilator" (default) or "questa" (ModelSim/QuestaSim).
# questa needs vlib/vlog/vsim on PATH; it also accepts .v (Verilog) sources.
SIM_TOOL=verilator
TRACE_WINDOW_EDGES=10
VERILATOR_BUILD_TIMEOUT=240
VERILATOR_RUN_TIMEOUT=60
# Static lint (Verilator --lint-only). Warnings are recorded unless promoted.
LINT_ENABLED=1
LINT_FAIL_ON_ERROR=0
# Comma-separated warning codes promoted to errors, e.g. WIDTH,LATCH,MULTIDRIVEN
LINT_ERROR_ON=
# Coverage-guided test augmentation.
COVERAGE_ENABLED=0
COVERAGE_MIN=0.80
COVERAGE_ROUNDS=1
# Mutation testing (measures testbench quality; opt-in).
MUTATION_ENABLED=0
MUTATION_BUDGET=20
MUTATION_ROUNDS=1
# Parallel mutant simulations (<=1 runs them sequentially). Keep modest because
# Verilator already builds each mutant on all cores (-j 0).
MUTATION_CONCURRENCY=4
